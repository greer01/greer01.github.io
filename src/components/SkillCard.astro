---
const { name, level = 2, icon } = Astro.props;
---

<div class="skill-card">
  <div class="skill-left">
  {icon && <img src={icon} alt={`${name} icon`} />}
  </div>

  <div class="skill-label">{name}</div>

  <div class="skill-level">
    {[1,2,3].map(i => (
      <div class={`dot ${i <= level ? "filled" : ""}`}></div>
    ))}
  </div>
</div>