---
const { title, description, tags = [] } = Astro.props;
---

<div class="course-card">

  <div class="course-main">
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </div>

  <div class="course-subgrid">
    {tags.map(tag => (
      <div class="course-sub">{tag}</div>
    ))}
  </div>

</div>