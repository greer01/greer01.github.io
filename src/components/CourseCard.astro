---
const { title } = Astro.props;
---

<article class="course-card">

  <header class="course-main">
    <h3>{title}</h3>
  </header>

  <div class="course-subgrid">
    <div class="course-sub">1</div>
    <div class="course-sub">2</div>
    <div class="course-sub">3</div>
    <div class="course-sub">4</div>
  </div>

</article>