---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Grid.astro";
import CourseCard from "../components/CourseCard.astro";
import SkillCard from "../components/SkillCard.astro";

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>

  <section id="hero" class="hero">
    <Hero />
    <p class="sr-only">Hero section</p>
  </section>

  <section id="courses-projects">
    <h2 class="work-header">Courses</h2>
    <div class="work-top">
      <div class="courses-grid">
        <CourseCard title="Course 1" />
        <CourseCard title="Course 2" />
        <CourseCard title="Course 3" />
        <CourseCard title="Course 4" />
        <CourseCard title="Course 5" />
        <CourseCard title="Course 6" />
      </div>
    </div>

    <h2 class="work-header">Projects</h2>
    <div class="work-bottom">
      <div class="grid-3 gap-large">
        <Card />
        <Card />
        <Card />
      </div>
    </div>

    <p class="sr-only">Courses and projects section</p>
  </section>

  <section id="skills">
    <h2>Skills</h2>
    <div class="skills-grid">
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
      <SkillCard name="Lorem Ipsum" />
    </div>
    <p class="sr-only">Skills section</p>
  </section>

  <section id="about">
    <h2>About</h2>
    <div class="about-grid">
      <div class="about-image">
        <img src="/PlacePicture.png" alt="Your Name" />
      </div>
      <div class="about-text">
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
      </div>
    </div>
  </section>

</BaseLayout>