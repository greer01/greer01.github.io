---
import Hero from "../components/Hero.astro";
import Card from "../components/Grid.astro";
import CourseCard from "../components/CourseCard.astro";
import SkillCard from "../components/SkillCard.astro";
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>

  <section id="hero" class="hero">
    <Hero />
    <p class="sr-only">Hero section</p>
  </section>

  <section id="Courses & Projects">
    <h2 class="work-header">Courses</h2>
    <div class="work-top">
      <div class="courses-grid">
        <CourseCard 
  title="Programming Languages"
  description="Built predictive models and neural networks using real datasets."
  tags={[
  { name: "Python", icon: "/Python2.svg" },
  { name: "Java", icon: "/Java.svg" },
  { name: "Models", icon: "/Model1.svg" },
  { name: "Data", icon: "/Data1.svg" }
]}
/>

<CourseCard 
  title="Data Structures"
  description="Implemented efficient algorithms and data organization techniques."
  tags={[
    { name: "Arrays", icon: "/Array.svg" },
    { name: "Matplotlib", icon: "/Matplotlib.svg" },
    { name: "Graphs", icon: "/Graphs.svg" },
    { name: "Algorithms", icon: "/Algorithm.svg" }
    ]}
/>

<CourseCard 
  title="Data Exploration"
  description="Worked with relational databases and SQL queries."
  tags={[
    { name: "SQL", icon: "/SQL.svg" },
    { name: "Queries", icon: "/Queries.svg" },
    { name: "Joins", icon: "/Joins.svg" },
    { name: "Design", icon: "/Design.svg" }
  ]}
/>

<CourseCard 
  title="Economical Statistics I & II"
  description="Applied statistical analysis and hypothesis testing."
  tags={[
    { name: "Stats", icon: "/Stats.svg" },
    { name: "Testing", icon: "/Testing.svg" },
    { name: "Probability", icon: "/Probability.svg" },
    { name: "Data", icon: "/Data1.svg" }
  ]}
/>

<CourseCard 
  title="Deep Learning"
  description="Trained neural networks including CNNs and RNNs."
  tags={[
    { name: "CNN", icon: "/CNN.svg" },
    { name: "RNN", icon: "/RNN.svg" },
    { name: "PyTorch", icon: "/PyTorch.svg" },
    { name: "Training", icon: "/Training.svg" }
  ]}
/>

<CourseCard 
  title="Data Science"
  description="Created visual insights using Python and R."
  tags={[
    { name: "Charts", icon: "/Charts.svg" },
    { name: "Graphs", icon: "/Graphs.svg" },
    { name: "Python", icon: "/Python2.svg" },
    { name: "R", icon: "/R.svg" }
  ]}
/>
      </div>
    </div>

<h2 class="work-header">Projects</h2>

<div class="work-bottom">
  <div class="projects-grid">

    <div class="card">
      <h3>CaddySense: AI Golf Assistant</h3>
      <p>
        Developed an AI-powered golf caddy tool that provides strategic game recommendations based on course data, player tendencies, and personalization factors.
      </p>
      <p><strong>Tech:</strong> Python, AI Modeling</p>
    </div>

    <div class="card">
      <h3>Golf Tournament Prediction Model</h3>
      <p>
        Built a neural network using PyTorch to predict tournament winners using performance metrics like driving distance and scoring average.
      </p>
      <p><strong>Tech:</strong> Python, PyTorch</p>
    </div>

    <div class="card">
      <h3>CNN Image Classification</h3>
      <p>
        Trained and evaluated ShuffleNet and MobileNet models on CIFAR-10, testing architecture and activation function variations.
      </p>
      <p><strong>Tech:</strong> Python, Deep Learning</p>
    </div>

    <div class="card">
      <h3>Class Web Design Project</h3>
      <p>
        Worked on a team to design a website for a local business in downtown Meadville.
      </p>
      <p><strong>Tech:</strong> Wix, Teamwork, Problem Solving</p>
    </div>

    <div class="card">
      <h3>Data Cleaning Experiment</h3>
      <p>
        Cleaned a massive dataset using Python and R. Ran tests to see which language would be better at cleaning and organizing data.
      </p>
      <p><strong>Tech:</strong> Python, R</p>
    </div>

  </div>
</div>
    </div>

    <p class="sr-only">Courses and projects section</p>
  </section>

  <section id="skills">
  <h2>Skills</h2>

  <div class="skills-columns">

    <div class="skill-column">
      <h3>Languages</h3>
      <SkillCard name="Python" level={2} icon="/Python2.svg" />
      <SkillCard name="R" level={2} icon="/R.svg"/>
      <SkillCard name="Java" level={1} icon="/Java.svg" />
      <SkillCard name="SQL" level={1} icon="/SQL.svg"/>
    </div>

    <div class="skill-column">
      <h3>Data & AI</h3>
      <SkillCard name="Machine Learning" level={2} icon="MachineLearning.jpg" />
      <SkillCard name="Deep Learning" level={2} icon="DeepLearning.jpg" />
      <SkillCard name="PyTorch" level={1} icon="/PyTorch.svg" />
      <SkillCard name="Statistical Modeling" level={2} icon="StatisticalModeling.png"/>
    </div>

    <div class="skill-column">
      <h3>General</h3>
      <SkillCard name="Problem Solving" level={2} icon="ProblemSolving.jpg"/>
      <SkillCard name="Data Analysis" level={2} icon="DataAnalysis.png" />
      <SkillCard name="Data Visualization" level={2} icon="DataVisualization.png"/>
      <SkillCard name="Algorithm Design" level={2} icon="AlgorithmDesign.jpg"/>
    </div>

  </div>

  <p class="sr-only">Skills section</p>
</section>

  <section id="about">
    <h2>About</h2>
    <div class="about-grid">
      <div class="about-image">
        <img src="/ProfilePicture.JPG" alt="Logan Greer" />
      </div>
      <div class="about-text">
        <p>
          I am a Data Science student at Allegheny College with a strong interest in sports analytics and machine learning. As a member of the college golf team, I am especially passionate about applying data-driven insights to improve performance and decision-making in sports.

          Through my coursework and projects, I have developed experience building neural networks, training deep learning models, and analyzing complex datasets using tools like Python and PyTorch. My work includes projects such as an AI-powered golf caddy and predictive models for tournament outcomes.

          I am always looking to expand my skills and explore new applications of data science, particularly in areas where analytics can create a meaningful competitive advantage.
        </p>
      </div>
    </div>
  </section>
<button id="backToTop" aria-label="Back to top">↑</button>
<script>
  const btn = document.getElementById("backToTop");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 300) {
      btn.classList.add("show");
    } else {
      btn.classList.remove("show");
    }
  });

  btn.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  });
</script>
</BaseLayout>