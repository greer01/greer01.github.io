---
import Hero from "../components/Hero.astro";
import Card from "../components/Grid.astro";
import CourseCard from "../components/CourseCard.astro";
import SkillCard from "../components/SkillCard.astro";
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>

  <section id="hero" class="hero">
    <Hero />
    <p class="sr-only">Hero section</p>
  </section>

  <section id="Courses & Projects">
    <h2 class="work-header">Courses</h2>
    <div class="work-top">
      <div class="courses-grid">
        <CourseCard title="Course 1" />
        <CourseCard title="Course 2" />
        <CourseCard title="Course 3" />
        <CourseCard title="Course 4" />
        <CourseCard title="Course 5" />
        <CourseCard title="Course 6" />
      </div>
    </div>

    <h2 class="work-header">Projects</h2>
    <div class="work-bottom">
      <div class="grid-3 gap-large">

  <!-- CaddySense -->
  <div class="card">
    <h3>CaddySense: AI Golf Assistant</h3>
    <p>
      Developed an AI-powered golf caddy tool that provides strategic game recommendations based on course data, player tendencies, and personalization factors.
    </p>
    <p><strong>Tech:</strong> Python, AI Modeling</p>
  </div>

  <!-- Golf NN -->
  <div class="card">
    <h3>Golf Tournament Prediction Model</h3>
    <p>
      Built a neural network using PyTorch to predict tournament winners using performance metrics like driving distance and scoring average.
    </p>
    <p><strong>Tech:</strong> Python, PyTorch</p>
  </div>

  <!-- CNN -->
  <div class="card">
    <h3>CNN Image Classification</h3>
    <p>
      Trained and evaluated ShuffleNet and MobileNet models on CIFAR-10, testing architecture and activation function variations.
    </p>
    <p><strong>Tech:</strong> Python, Deep Learning</p>
  </div>

</div>
    </div>

    <p class="sr-only">Courses and projects section</p>
  </section>

  <section id="skills">
    <h2>Skills</h2>
    <div class="skills-grid">
      <SkillCard name="Python" level={2} icon="/Python.png" />
      <SkillCard name="PyTorch" level={1} icon="PyTorch.jpg" />
      <SkillCard name="Machine Learning" level={2} icon="MachineLearning.jpg" />

      <SkillCard name="Deep Learning" level={2} icon="DeepLearning.jpg" />
      <SkillCard name="Data Analysis" level={2} icon="DataAnalysis.png" />
      <SkillCard name="Data Visualization" level={2} icon="DataVisualization.png"/>

      <SkillCard name="SQL" level={1} icon="SQL.png"/>
      <SkillCard name="R" level={2} icon="R.png"/>
      <SkillCard name="Java" level={1} icon="Java.png" />

      <SkillCard name="Problem Solving" level={2} icon="ProblemSolving.jpg"/>
      <SkillCard name="Statistical Modeling" level={2} icon="StatisticalModeling.png"/>
      <SkillCard name="Algorithm Design" level={2} icon="AlgorithmDesign.jpg"/>
    </div>
    <p class="sr-only">Skills section</p>
  </section>

  <section id="about">
    <h2>About</h2>
    <div class="about-grid">
      <div class="about-image">
        <img src="/ProfilePicture.JPG" alt="Logan Greer" />
      </div>
      <div class="about-text">
        <p>
          I am a Data Science student at Allegheny College with a strong interest in sports analytics and machine learning. As a member of the college golf team, I am especially passionate about applying data-driven insights to improve performance and decision-making in sports.

          Through my coursework and projects, I have developed experience building neural networks, training deep learning models, and analyzing complex datasets using tools like Python and PyTorch. My work includes projects such as an AI-powered golf caddy and predictive models for tournament outcomes.

          I am always looking to expand my skills and explore new applications of data science, particularly in areas where analytics can create a meaningful competitive advantage.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>