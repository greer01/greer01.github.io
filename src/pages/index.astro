---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionWrapper from "../components/Section.astro";
import Card from "../components/Grid.astro";
import CourseCard from "../components/CourseCard.astro";
import SkillCard from "../components/SkillCard.astro";
---

<BaseLayout pageTitle="Home">

  <Hero />

  <SectionWrapper id="Courses & Projects">

  <div class="work-split">

    <div class="work-top">
      <h2>Courses</h2>
      <div class="courses-grid">
        <CourseCard title="Course 1" />
        <CourseCard title="Course 2" />
        <CourseCard title="Course 3" />
        <CourseCard title="Course 4" />
        <CourseCard title="Course 5" />
        <CourseCard title="Course 6" />
      </div>
    </div>

    <div class="work-bottom">
      <h2>Projects</h2>
      <div class="grid-3 gap-large">
        <Card/>
        <Card/>
        <Card/>
      </div>
    </div>

  </div>

</SectionWrapper>

  <SectionWrapper title="Skills" id="skills">
    <div class="skills-grid">
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
    <SkillCard name="Lorem Ipsum" />
  </div>
  </SectionWrapper>

  <SectionWrapper id="about" title="About">
  <div class="about-grid">
    <div class="about-image">
      <img src="/PlacePicture.png" alt="Your Name" />
    </div>

    <div class="about-text">
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit.
      </p>
    </div>
  </div>
</SectionWrapper>

</BaseLayout>